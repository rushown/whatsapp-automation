# ─── SERVER ───────────────────────────────────────────
PORT=5000
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
FRONTEND_URL=http://localhost:5173

# ─── SUPABASE ─────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── META WHATSAPP CLOUD API ──────────────────────────
META_APP_SECRET=your_meta_app_secret
META_WHATSAPP_TOKEN=your_permanent_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_BUSINESS_ACCOUNT_ID=your_waba_id
WEBHOOK_VERIFY_TOKEN=your_random_verify_token
WHATSAPP_API_VERSION=v21.0

# ─── OPENAI (embeddings for intent matching) ──────────
OPENAI_API_KEY=sk-your-openai-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_INTENT_THRESHOLD=0.78
INTENT_AMBIGUITY_MARGIN=0.04
INTENT_CACHE_TTL_MS=60000
PHONE_RATE_LIMIT_PER_MIN=30

# ─── AI PROVIDERS (response personalization) ────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ─── ELEVENLABS (voice replies) ───────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75

# ─── ADMIN SEED (optional, for local without Supabase) ─
TEST_USER_EMAIL=admin@example.com
TEST_USER_PASSWORD=Admin@1234

# ─── FRONTEND (Vite) ──────────────────────────────────
VITE_API_URL=http://localhost:5000
